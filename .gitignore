# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 실제 비밀값이 든 .env는 커밋 금지, .env.example은 템플릿이라 커밋 대상
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tesseract.js가 첫 실행 시 캐시로 내려받는 언어 데이터(레포 루트) — 자동 재다운로드되므로
# 커밋 불필요. lib/server/tessdata/ 안의 파일은 배포 번들에 실제로 포함하는 것이므로 예외.
/*.traineddata
