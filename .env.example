# Supabase 프로젝트 기본 URL (Settings > API > Project URL, 끝에 /rest/v1/ 붙이지 않음)
NEXT_PUBLIC_SUPABASE_URL=

# anon public key (Settings > API) — 브라우저가 서명된 업로드 URL로 사진을 Storage에
# 직접 올릴 때 씀(lib/client/supabaseClient.ts). 실제 권한은 서명 토큰이 쥐고 있어서
# 이 키 자체는 공개돼도 안전하다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key (Settings > API) — 절대 브라우저로 노출되면 안 됨.
# lib/server/ 아래 서버 전용 코드에서만 사용 (server-only 패키지로 클라이언트 import 차단)
SUPABASE_SERVICE_ROLE_KEY=

# 베타 로그인 세션 쿠키 서명용 비밀키 (openssl rand -base64 32 등으로 생성)
SESSION_SECRET=

# 베타 테스터 ID/PW 목록 (JSON) — 예: [{"id":"tester01","password":"..."}]
BETA_TESTERS=
